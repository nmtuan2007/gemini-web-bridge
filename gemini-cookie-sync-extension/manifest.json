{
  "manifest_version": 3,
  "name": "Gemini Web2API Controller",
  "version": "2.1",
  "description": "One-click Start/Stop controller, live request monitor, and auto cookie sync for local gemini-web2api.",
  "key": "",
  "permissions": [
    "cookies",
    "downloads",
    "tabs",
    "scripting",
    "nativeMessaging",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "*://google.com/*",
    "*://*.google.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Gemini Web2API",
    "default_popup": "popup.html"
  }
}
